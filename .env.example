# Supabase PostgreSQL Database URLs
# Pooled connection on port 6543 (used at runtime)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection on port 5432 (used for migrations)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# GitHub Webhook Secret
GITHUB_WEBHOOK_SECRET="your-github-webhook-secret-here"

# Seed User Passwords
SEED_ADMIN_PASSWORD="your-admin-seed-password-here"
SEED_VIEWER_PASSWORD="your-viewer-seed-password-here"

# Auth Secret (generate with: openssl rand -base64 32)
AUTH_SECRET="your-auth-secret-here"
GITHUB_TOKEN=

# Demo accounts for the login page Quick Fill buttons
# DEMO_VIEWER_EMAIL and DEMO_VIEWER_PASSWORD are shown in all environments when set.
# DEMO_ADMIN_EMAIL and DEMO_ADMIN_PASSWORD are only shown in non-production environments.
DEMO_VIEWER_EMAIL=
DEMO_VIEWER_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
